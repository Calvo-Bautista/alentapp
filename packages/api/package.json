{
    "name": "@alentapp/api",
    "version": "1.0.0",
    "type": "module",
    "main": "src/app.ts",
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "build": "prisma generate --config prisma.config.ts && esbuild $(find src -name '*.ts' ! -name '*.test.ts' ! -name '*.integration.test.ts' ! -name '*.e2e.test.ts' ! -path 'src/generated/*') --outdir=dist --outbase=src --platform=node --format=esm --target=node22 && cp -r src/generated dist/generated",
        "start": "node dist/app.js",
        "test": "npm run test:unit && npm run test:integration",
        "test:unit": "vitest run --config vitest.unit.config.ts",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "test:watch": "vitest --config vitest.unit.config.ts",
        "coverage": "vitest run --config vitest.unit.config.ts --coverage"
    },
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-prometheus": "^0.218.0",
        "@opentelemetry/instrumentation-fastify": "^0.56.0",
        "@opentelemetry/instrumentation-http": "^0.218.0",
        "@opentelemetry/sdk-node": "^0.218.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.7.0",
        "fastify": "^5.8.5",
        "pg": "^8.20.0"
    },
    "devDependencies": {
        "@types/pg": "^8.20.0",
        "@vitest/coverage-v8": "^4.1.5",
        "dotenv": "^16.6.1",
        "esbuild": "^0.27.7",
        "prisma": "^7.7.0",
        "tsx": "^4.21.0",
        "vitest": "^4.1.5"
    }
}
